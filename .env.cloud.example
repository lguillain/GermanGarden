# Copy these values into .env.local for cloud-backed frontend development.
# These two values are public browser configuration, not server secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# GitHub Actions sets this automatically; use / for local development.
VITE_BASE_PATH=/
