{
  "name": "german-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test --config playwright.cloud.config.ts",
    "test:cloud": "node --import tsx --test tests/cloud/*.test.ts",
    "check:cloud": "tsc -p tsconfig.cloud.json",
    "import:local": "node --import tsx scripts/import-local.ts",
    "configure:local": "node --import tsx scripts/configure-local.ts",
    "format:cloud": "prettier --write \"supabase/functions/garden/**/*.ts\"",
    "check:format:cloud": "prettier --check \"supabase/functions/garden/**/*.ts\"",
    "format:frontend": "prettier --write \"frontend/src/**/*.{ts,tsx}\"",
    "check:format:frontend": "prettier --check \"frontend/src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "5.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
